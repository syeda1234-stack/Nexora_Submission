# Copy values into your terminal/server environment; never commit real secrets.
# Gemini (recommended starter; check current quotas/pricing in Google AI Studio)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
# Optional OpenAI provider: set NEXORA_AI_PROVIDER=openai as well
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto = Gemini first, then Ollama, then offline agent (recommended). Or: gemini | ollama | openai
NEXORA_AI_PROVIDER=auto
# Optional database file location (default: nexora.db beside app.py)
NEXORA_DB_PATH=

# Optional Ollama Cloud provider
# Set NEXORA_AI_PROVIDER=ollama to enable it
OLLAMA_API_KEY=PASTE_YOUR_OLLAMA_KEY_HERE
OLLAMA_MODEL=gpt-oss:120b
